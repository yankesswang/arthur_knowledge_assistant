# === Local env (machine-specific) ===
.env
.env.local

# === OS / editor cruft ===
.DS_Store
**/.DS_Store

# === Python ===
__pycache__/
*.pyc
*.pyo
.venv/
**/.venv/
.ruff_cache/

# === Node ===
node_modules/
**/node_modules/

# === Audio & large media ===
*.mp3
*.mp4
*.wav
*.m4a

# === Vendored third-party git clones (each has its own .git) ===
